ENVIRONMENT=development
ENABLE_SCHEDULER=true
ENABLE_EXCHANGE_WEBSOCKETS=true
MARKET_POLL_SECONDS=30
WEBSOCKET_BATCH_MS=500
REST_FALLBACK_SECONDS=120
AEVO_REFRESH_INTERVAL_SECONDS=300
AEVO_REQUEST_INTERVAL_SECONDS=1.0
AEVO_MAX_CONCURRENT_REQUESTS=2
DATABASE_URL=postgresql+asyncpg://arbitrage:arbitrage@postgres:5432/arbitrage
REDIS_URL=redis://redis:6379/0
DEFAULT_MIN_APR=10
DEFAULT_MIN_OPEN_INTEREST=100000
BASIS_THRESHOLD_BPS=200
CAPACITY_FRACTION=0.05
AUTO_UNWIND=true
LIVE_TRADING_ENABLED=false
SIMULATION_INITIAL_BALANCE_USD=1000
SIMULATION_LEVERAGE=3
# ALERT_WEBHOOK_URL=
